# Copy to .env next to compose.household.yml and fill in. Never commit .env.

# Public hostname the reverse proxy serves (no scheme), e.g. sure.example.com
APP_DOMAIN=

# Generate each with: openssl rand -hex 64   (password: openssl rand -hex 24)
SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Host port the web container listens on (bound to 127.0.0.1 only)
PORT=3010

# OpenRouter: powers the assistant, PDF statement reading and auto-labelling.
# See docs/redesign/openrouter.md for picking a free tool-calling model.
OPENAI_ACCESS_TOKEN=
OPENAI_URI_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemma-4-31b-it:free
# OPENAI_EXTRA_HEADERS={"HTTP-Referer":"https://sure.example.com","X-Title":"Sure"}
