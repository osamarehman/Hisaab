# Copy to .env next to compose.household.yml and fill in. Never commit .env.

# Public hostname the reverse proxy serves (no scheme), e.g. sure.example.com
APP_DOMAIN=

# Generate each with: openssl rand -hex 64   (password: openssl rand -hex 24)
SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Host port the web container listens on (bound to 127.0.0.1 only)
PORT=3010

# OpenRouter: powers the assistant, PDF statement reading and auto-labelling.
# See docs/redesign/openrouter.md for picking a free tool-calling model.
OPENAI_ACCESS_TOKEN=
OPENAI_URI_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemma-4-31b-it:free
# OPENAI_EXTRA_HEADERS={"HTTP-Referer":"https://sure.example.com","X-Title":"Sure"}

# Sign-up is open, so limit the OpenRouter quota to your own household:
# comma-separated emails; only households with one of these members get the
# assistant, AI auto-labelling and PDF statement reading (others import CSV).
# Leave empty to let every household use AI.
AI_ALLOWED_EMAILS=

# Google sign-in: OAuth web client ID and secret (redirect URI
# https://<APP_DOMAIN>/auth/google_oauth2/callback). Blank hides nothing but
# makes the button answer "SSO not configured".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Passkeys. RP ID is the domain passkeys belong to; changing it later orphans
# every existing passkey. Fingerprints are the colon-separated SHA-256 of each
# Android signing cert (Play App Signing key, upload key), comma-separated.
WEBAUTHN_RP_ID=hisaab.shipdeck.dev
WEBAUTHN_ALLOWED_ORIGINS=https://hisaab.shipdeck.dev
ANDROID_APP_PACKAGE_NAME=dev.shipdeck.hisaab
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
