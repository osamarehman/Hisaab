<%# locals: (budget:, editable:) %>

<div class="flex flex-wrap items-center justify-between gap-3 border-l-2 border-warning bg-warning/10 px-4 py-3">
  <p class="text-sm text-primary"><%= t(".over_allocated_message") %></p>

  <% if editable %>
    <%= render DS::Link.new(
      text: t(".fix_allocations"),
      variant: "secondary",
      size: "sm",
      href: budget_budget_categories_path(budget, **budget_owner_query)
    ) %>
  <% end %>
</div>
