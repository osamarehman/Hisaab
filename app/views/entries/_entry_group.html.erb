<%# locals: (date:, entries:, content:, totals: false) %>

<div id="entry-group-<%= date %>" class="w-full" data-bulk-select-target="group">
  <div class="pt-5 pb-1.5 px-3 lg:px-4 flex items-center justify-between font-medium text-xs text-secondary border-b border-solid">
    <div class="flex pl-0.5 items-center gap-4">
        <%= check_box_tag "#{date}_entries_selection",
                          class: ["checkbox checkbox--light hidden lg:block", "lg:hidden": entries.size == 0],
                          id: "selection_entry_#{date}",
                          data: {
                            action: "bulk-select#toggleGroupSelection",
                            checkbox_toggle_target: "selectionEntry"
                          } %>

      <p class="font-mono tabular-nums space-x-1.5">
        <%= tag.span I18n.l(date, format: :long) %>
        <span>·</span>
        <%= tag.span entries.size %>
      </p>
    </div>

    <% if totals %>
      <div id="entry-group-<%= date %>-totals" class="font-mono tabular-nums privacy-sensitive">
        <%= totals_by_currency(collection: entries, money_method: :amount_money, negate: true) %>
      </div>
    <% end %>
  </div>
  <div class="[&>*]:border-b [&>*]:border-divider">
    <%= content %>
  </div>
</div>
