<%# locals: (totals:) %>
<%# Show Inflow/Outflow labels only when the result set contains exclusively transfers
    (income and expense are both $0). For mixed filters (e.g. Expense+Transfer),
    we keep Income/Expenses labels — transfer amounts aren't included in the summary
    bar in that case, though the transaction list still shows both types. %>
<% show_transfers = totals.income_money.zero? && totals.expense_money.zero? &&
   (totals.transfer_inflow_money.amount > 0 || totals.transfer_outflow_money.amount > 0) %>
<% income = show_transfers ? totals.income_money + totals.transfer_inflow_money : totals.income_money %>
<% expense = show_transfers ? totals.expense_money + totals.transfer_outflow_money : totals.expense_money %>
<%= render DS::StatGrid.new do |grid| %>
  <% grid.with_tile(label: t("transactions.summary.total_transactions"), value: tag.span(totals.count.round(0), id: "total-transactions")) %>
  <% grid.with_tile(label: t(show_transfers ? "transactions.summary.inflow" : "transactions.summary.income"), value: tag.span(income.format, id: "total-income"), tone: :in) %>
  <% grid.with_tile(label: t(show_transfers ? "transactions.summary.outflow" : "transactions.summary.expenses"), value: tag.span(expense.format, id: "total-expense")) %>
<% end %>
