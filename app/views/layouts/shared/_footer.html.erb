<footer class="p-6">
  <div class="space-y-2 text-center text-xs text-secondary">
    <p><%= t("layouts.shared.footer.copyright", year: Date.current.year, product_name: [ brand_name, product_name ].compact.join(" ")) %></p>
    <div class="flex flex-wrap justify-center items-center gap-2">
      <%= link_to t("layouts.shared.footer.privacy"), privacy_path, class: "text-secondary", target: "_blank" %>
      <span>&bull;</span>
      <%= link_to t("layouts.shared.footer.terms"), terms_path, class: "text-secondary", target: "_blank" %>
      <span>&bull;</span>
      <%= link_to t("layouts.shared.footer.account_deletion"), account_deletion_path, class: "text-secondary", target: "_blank" %>
      <span>&bull;</span>
      <%= link_to t("layouts.shared.footer.source_code"), Rails.configuration.x.source_code_url, class: "text-secondary", target: "_blank", rel: "noopener noreferrer" %>
    </div>
  </div>
</footer>
