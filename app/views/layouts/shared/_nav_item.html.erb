<%# locals: (name:, path:, icon:, icon_custom:, active:, key: nil, badge: 0, variant: :sidebar) %>
<%# :sidebar — a full-width text row, ink-filled when current (desktop sidebar
    and the phone's menu sheet). :tab — an icon over a label for the phone's
    bottom bar, marked by a cobalt rule along its top edge when current. %>
<% if variant == :tab %>
  <%= link_to path,
      class: class_names(
        "flex flex-1 flex-col items-center justify-center gap-0.5 min-h-14 border-t-2 text-xs focus-ring",
        active ? "border-link font-semibold text-primary" : "border-transparent text-secondary"
      ),
      aria: { current: ("page" if active) } do %>
    <%= icon(icon, color: "current", custom: icon_custom) %>
    <span><%= name %></span>
  <% end %>
<% else %>
  <%= link_to path,
      class: class_names(
        "flex items-center justify-between gap-2 min-h-11 px-3 text-base focus-ring",
        active ? "bg-inverse text-inverse font-semibold" : "text-primary hover:bg-surface-inset-hover"
      ),
      aria: { current: ("page" if active) } do %>
    <span><%= name %></span>
    <% if badge.to_i.positive? %>
      <span class="px-1.5 py-0.5 bg-warning text-inverse font-mono text-xs tabular-nums" aria-hidden="true"><%= badge %></span>
      <span class="sr-only"><%= t("layouts.application.review_count", count: badge) %></span>
    <% end %>
  <% end %>
<% end %>
