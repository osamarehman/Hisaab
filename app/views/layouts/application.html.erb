<% intro_mode = Current.user&.ui_layout_intro? %>
<% home_path = intro_mode ? chats_path : root_path %>
<%# Assistant type "mcp_only" removes every chat surface. MCP is unaffected. %>
<% assistant_enabled = Current.family.assistant_enabled? %>
<% nav_items = primary_nav_items %>
<% tab_items = mobile_tab_nav_items(nav_items) %>
<% expanded_sidebar_class = "w-full" %>
<% collapsed_sidebar_class = "w-0 overflow-hidden" %>
<% wordmark_classes = "font-display font-bold tracking-tight leading-none text-primary focus-ring" %>

<%= render "layouts/shared/htmldoc", sidebar_aware: true do %>
  <div
    class="flex flex-col lg:flex-row h-full bg-surface"
    data-controller="app-layout privacy-mode sidebar-resize"
    data-app-layout-expanded-sidebar-class="<%= expanded_sidebar_class %>"
    data-app-layout-collapsed-sidebar-class="<%= collapsed_sidebar_class %>"
    data-app-layout-user-id-value="<%= Current.user.id %>">
    <%= link_to t("layouts.application.skip_to_main"), "#main",
        class: "sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:bg-container focus:text-primary focus:border focus:border-solid" %>

    <%# MOBILE - Menu sheet: every destination, for the ones the bottom bar has no room for.
        Intro users have only two, both in the bottom bar. %>
    <% unless intro_mode %>
    <div
      class="hidden fixed inset-0 z-30 bg-surface h-full w-full pt-[calc(env(safe-area-inset-top)+0.75rem)] pr-4 pb-[calc(env(safe-area-inset-bottom)+0.75rem)] pl-4 overflow-y-auto lg:hidden"
      data-app-layout-target="mobileSidebar">
      <div class="flex flex-col gap-6">
        <div class="flex items-center justify-between">
          <span class="<%= wordmark_classes %> text-3xl"><%= product_name %></span>
          <%= icon("x", as_button: true, aria_label: t("layouts.application.close_menu"), data: { action: "app-layout#closeMobileSidebar" }) %>
        </div>
        <nav aria-label="<%= t("layouts.application.primary_nav") %>">
          <ul>
            <% nav_items.each do |nav_item| %>
              <li><%= render "layouts/shared/nav_item", **nav_item %></li>
            <% end %>
          </ul>
        </nav>
      </div>
    </div>
    <% end %>

    <%# MOBILE - Top bar %>
    <header class="lg:hidden relative flex justify-between items-center px-3 pb-2 pt-[calc(env(safe-area-inset-top)+0.5rem)] border-b border-divider">
      <div class="flex items-center gap-1">
        <% unless intro_mode %>
          <%= icon("menu", as_button: true, aria_label: t("layouts.application.open_menu"), data: { action: "app-layout#openMobileSidebar" }) %>
          <%= render "layouts/shared/insights_button" %>
        <% end %>
      </div>

      <%= link_to product_name, home_path, class: "#{wordmark_classes} text-2xl absolute left-1/2 -translate-x-1/2" %>

      <div class="flex items-center gap-1">
        <%= render "layouts/shared/privacy_toggle" %>
        <%= render "users/user_menu", user: Current.user, placement: "bottom-end", offset: 12, intro_mode: intro_mode %>
      </div>
    </header>

    <%# DESKTOP - Sidebar %>
    <aside class="hidden lg:flex flex-col gap-7 w-56 shrink-0 px-5 py-7 border-r border-solid bg-container overflow-y-auto">
      <%= link_to product_name, home_path, class: "#{wordmark_classes} text-3xl self-start" %>

      <% unless intro_mode %>
        <%= render DS::Link.new(
          text: t("layouts.application.add_expense"),
          icon: "plus",
          variant: "cta",
          size: :lg,
          full_width: true,
          href: new_transaction_path,
          frame: :modal
        ) %>
      <% end %>

      <nav aria-label="<%= t("layouts.application.primary_nav") %>">
        <ul>
          <% nav_items.each do |nav_item| %>
            <li><%= render "layouts/shared/nav_item", **nav_item %></li>
          <% end %>
        </ul>
      </nav>

      <div class="mt-auto flex items-center gap-2.5 min-w-0">
        <%= render "users/user_menu", user: Current.user, placement: "top-start", intro_mode: intro_mode %>
        <span class="truncate text-sm text-primary"><%= Current.user.display_name %></span>
      </div>
    </aside>

    <%# SHARED - Main content %>
    <%= tag.main id: "main", class: "grow overflow-y-auto px-4 lg:px-10 w-full mx-auto pb-[calc(5rem+env(safe-area-inset-bottom))] lg:pb-16", data: { app_layout_target: "content", viewport_target: "content", notification_tray_target: "main" } do %>
      <% unless intro_mode %>
        <div class="hidden lg:flex gap-2 items-center justify-between mb-8 sticky top-0 z-10 -mx-10 px-10 py-3 bg-surface border-b border-divider">
          <% if content_for?(:breadcrumbs) %>
            <%= yield :breadcrumbs %>
          <% else %>
            <%= render "layouts/shared/breadcrumbs", breadcrumbs: breadcrumbs %>
          <% end %>

          <div class="flex items-center gap-2">
            <%= render "layouts/shared/insights_button" %>
            <%= render "layouts/shared/privacy_toggle" %>

            <% if assistant_enabled %>
              <%= icon("panel-right", as_button: true, data: { action: "app-layout#toggleRightSidebar" }) %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="pt-6 lg:pt-0">
        <%= yield :system_alerts %>

        <% if content_for?(:page_header) %>
          <%= yield :page_header %>
        <% elsif content_for?(:page_title) %>
          <%= render DS::PageHeader.new(title: content_for(:page_title), class: "mb-8") do |header| %>
            <% if content_for?(:page_actions) %>
              <% header.with_actions { content_for(:page_actions) } %>
            <% end %>
          <% end %>
        <% end %>

        <%= yield %>
      </div>
    <% end %>

    <% if assistant_enabled %>
      <%# DESKTOP - Right sidebar %>
      <%= tag.div class: class_names(
            "hidden lg:block relative h-full shrink-0 transition-all duration-300 border-divider",
            Current.user.show_ai_sidebar? ? [expanded_sidebar_class, "border-l"] : [collapsed_sidebar_class, "border-l-0"],
          ),
          style: "max-width: var(--right-sidebar-width, 400px)",
          inert: !Current.user.show_ai_sidebar?,
          data: { app_layout_target: "rightSidebar", sidebar_resize_target: "rightSidebar" } do %>
        <%= render "layouts/shared/sidebar_resize_handle", side: "right" %>
        <%= tag.div id: "chat-container", class: "relative h-full px-4 overflow-y-auto", data: { controller: "chat hotkey", chat_response_timeout_value: Chat.response_timeout_ms, turbo_permanent: true } do %>
          <div class="flex flex-col h-full justify-between shrink-0">
            <%= turbo_frame_tag chat_frame, src: chat_view_path(@chat), loading: "lazy", class: "h-full" do %>
              <div class="flex justify-center items-center h-full">
                <%= icon("loader-circle", class: "animate-spin") %>
              </div>
            <% end %>
          </div>

          <% unless Current.user.ai_enabled? %>
            <div class="absolute backdrop-blur-lg inset-0 h-full w-full flex flex-col justify-center items-center px-4">
              <%= render "chats/ai_consent" %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%# MOBILE - Bottom bar: Home · Activity · Add · Assistant · Accounts %>
    <%= tag.nav class: "lg:hidden fixed bottom-0 left-0 right-0 z-10 flex items-stretch bg-container border-t border-solid pb-[env(safe-area-inset-bottom)]",
      aria: { label: t("layouts.application.primary_nav") },
      data: { viewport_target: "bottomNav" } do %>
      <% tab_items.each_with_index do |nav_item, index| %>
        <% if index == 2 && !intro_mode %>
          <%= link_to new_transaction_path,
              class: "flex flex-1 items-center justify-center min-h-14 focus-ring",
              aria: { label: t("layouts.application.add_expense") },
              data: { turbo_frame: :modal } do %>
            <span class="inline-flex items-center justify-center size-12 rounded-md bg-link text-inverse">
              <%= icon("plus", size: "lg", color: "current") %>
            </span>
          <% end %>
        <% end %>
        <%= render "layouts/shared/nav_item", **nav_item, variant: :tab %>
      <% end %>
    <% end %>
    <%# "What's new" release highlight: one dialog per deployed release,
        shown on first interaction and tracked per account. %>
    <% unless intro_mode %>
      <% if (tag = pending_release_tag) %>
        <%= render "layouts/shared/release_highlight", tag: tag %>
      <% end %>
    <% end %>
  </div>
<% end %>
