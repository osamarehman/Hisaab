<%# locals: (overview:, uncategorized_count:) %>
<% period = overview.period %>
<% month_name = l(overview.month, format: "%B") %>
<% previous_month_name = l(overview.month.prev_month, format: "%B") %>
<% month_query = { start_date: period.start_date.iso8601, end_date: period.end_date.iso8601 } %>

<div class="flex flex-col gap-10 mb-12">
  <%= render DS::StatGrid.new(aria: { label: t(".totals", month: month_name) }) do |grid| %>
    <% change = overview.spent_change %>
    <% grid.with_tile(
         label: t(".spent"),
         value: format_money(overview.spent, precision: 0),
         sub: if change.positive?
                t(".more_than", amount: format_money(change, precision: 0), month: previous_month_name)
              elsif change.negative?
                t(".less_than", amount: format_money(change.abs, precision: 0), month: previous_month_name)
              end
       ) %>
    <% grid.with_tile(label: t(".came_in"), value: format_money(overview.came_in, precision: 0), tone: :in) %>
    <% kept = overview.kept_percent %>
    <% grid.with_tile(
         label: t(".left_over"),
         value: format_money(overview.left_over, precision: 0),
         tone: overview.left_over.negative? ? :out : :default,
         sub: (t(".kept", percent: kept) if kept&.positive?)
       ) %>
  <% end %>

  <% if uncategorized_count.to_i.positive? %>
    <section class="flex flex-wrap items-center justify-between gap-4 border-l-2 border-warning bg-warning/10 px-5 py-4" aria-labelledby="needs-label-heading">
      <div class="flex min-w-0 flex-col gap-1">
        <h2 id="needs-label-heading" class="font-display text-xl font-semibold tracking-tight text-primary">
          <%= t(".needs_label.title", count: uncategorized_count) %>
        </h2>
        <p class="text-sm text-secondary"><%= t(".needs_label.body") %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= render DS::Link.new(
          text: t(".needs_label.review"),
          variant: "primary",
          href: transactions_path(q: { categories: [ Category::UNCATEGORIZED_FILTER_VALUE ] })
        ) %>
        <%= render DS::Link.new(
          text: t(".needs_label.import"),
          variant: "secondary",
          href: new_import_path,
          frame: :modal
        ) %>
      </div>
    </section>
  <% end %>

  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(26rem,100%),1fr))] gap-x-12 gap-y-10">
    <%= render DS::LedgerSection.new(title: t(".where_it_went"), link_text: t(".budget"), href: budgets_path, id: "where-it-went") do %>
      <% if overview.label_rows.any? %>
        <ul>
          <% overview.label_rows.each do |row| %>
            <li class="border-b border-divider">
              <%= render "pages/dashboard/label_row", row: row, href: (transactions_path(q: month_query.merge(categories: [ row.category.filter_value ])) unless row.category.other_investments?) %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="py-6 text-sm text-secondary"><%= t(".no_spending", month: month_name) %></p>
      <% end %>
    <% end %>

    <%= render DS::LedgerSection.new(title: t(".recent"), link_text: t(".all_activity"), href: transactions_path(q: month_query), id: "recent-activity") do %>
      <% if overview.recent_entries.any? %>
        <ul>
          <% overview.recent_entries.each do |entry| %>
            <% category = entry.entryable.category %>
            <li class="border-b border-divider">
              <%= link_to entry_path(entry), data: { turbo_frame: "drawer", turbo_prefetch: false }, class: "grid grid-cols-[3.5rem_minmax(0,1fr)_auto] items-center gap-3 min-h-12 py-1.5 text-primary hover:bg-surface-inset-hover focus-ring" do %>
                <span class="font-mono text-xs tabular-nums text-secondary"><%= l(entry.date, format: "%-d %b") %></span>
                <span class="flex min-w-0 flex-col">
                  <span class="truncate text-sm"><%= entry.name %></span>
                  <span class="truncate text-xs text-secondary">
                    <% if category %>
                      <%= render DS::LabelDot.new(color: category.color, label: category.name, size: :sm) %>
                    <% else %>
                      <%= t(".no_label") %>
                    <% end %>
                  </span>
                </span>
                <%= tag.span format_money(-entry.amount_money),
                      class: class_names("font-mono text-sm tabular-nums text-right privacy-sensitive", "text-success": entry.amount.negative?) %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="py-6 text-sm text-secondary"><%= t(".no_activity", month: month_name) %></p>
      <% end %>
    <% end %>
  </div>
</div>
