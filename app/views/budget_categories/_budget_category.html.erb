<%# locals: (budget_category:, show_budget_meta: true) %>

<% category_display_name = budget_category.category.display_name %>

<%= turbo_frame_tag dom_id(budget_category), class: "flex-1 min-w-0 block" do %>
  <%= link_to budget_budget_category_path(budget_category.budget, budget_category, **budget_owner_query), class: "group block w-full py-3 hover:bg-surface-inset-hover focus-ring", data: { turbo_frame: "drawer" } do %>

    <% if budget_category.initialized? %>
      <%# One ledger row: label and status, then the bar, then the figures. %>
      <div class="grid gap-x-6 gap-y-2 md:grid-cols-[minmax(0,12rem)_minmax(0,1fr)_12rem] md:items-center">
        <div class="flex min-w-0 items-center gap-2">
          <%= render DS::LabelDot.new(color: budget_category.category.color, label: category_display_name, class: "min-w-0 font-medium text-primary") %>
          <% if budget_category.over_budget? %>
            <span class="shrink-0 text-xs font-semibold text-warning"><%= t("reports.budget_performance.status.over") %></span>
          <% elsif budget_category.near_limit? %>
            <span class="shrink-0 text-xs text-warning"><%= t("reports.budget_performance.status.warning") %></span>
          <% end %>
        </div>

        <div class="flex min-w-0 flex-col gap-1.5">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
            <span class="font-mono tabular-nums text-primary privacy-sensitive"><%= format_money(budget_category.actual_spending_money) %></span>
            <% if show_budget_meta %>
              <span class="text-secondary">
                <%= t("reports.budget_performance.budgeted") %>:
                <span class="font-mono tabular-nums privacy-sensitive"><%= format_money(budget_category.budgeted_spending_money) %></span>
              </span>
              <% if budget_category.inherits_parent_budget? %>
                <span class="text-xs text-secondary"><%= t("reports.budget_performance.shared") %></span>
              <% end %>
            <% end %>
          </div>
          <%= render DS::LedgerBar.new(percent: budget_category.bar_width_percent, tone: budget_category.over_budget? ? :out : :default, size: :sm) %>
          <% if show_budget_meta %>
            <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-secondary">
              <% if budget_category.rolled_over? %>
                <span class="privacy-sensitive"><%= t("budget_categories.budget_category.rolled_over", amount: format_money(Money.new(budget_category.display_rolled_over_amount, budget_category.currency))) %></span>
              <% end %>
              <% if budget_category.suggested_daily_spending.present? %>
                <% daily_info = budget_category.suggested_daily_spending %>
                <span><%= t("reports.budget_performance.suggested_daily", amount: daily_info[:amount].format, days: daily_info[:days_remaining]) %></span>
              <% end %>
              <%# Bills reservations are metadata like the budgeted figure above, so
                  compact callers that opt out of the meta row stay compact. %>
              <% if (reserved = budget_category.bills_reserved).amount.positive? %>
                <span><%= t("budget_categories.bills_reserved", amount: format_money(reserved)) %></span>
              <% end %>
              <% if (unconvertible = budget_category.bills_reserved_unconvertible_count).positive? %>
                <span class="text-warning"><%= t("budget_categories.bills_reserved_unconvertible", count: unconvertible) %></span>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="text-sm md:text-right whitespace-nowrap">
          <% if budget_category.available_to_spend >= 0 %>
            <span class="text-secondary"><%= t("reports.budget_performance.remaining") %>:</span>
            <span class="font-mono tabular-nums text-primary privacy-sensitive"><%= format_money(budget_category.available_to_spend_money) %></span>
          <% else %>
            <span class="text-secondary"><%= t("reports.budget_performance.over_by") %>:</span>
            <span class="font-mono tabular-nums font-semibold text-warning privacy-sensitive"><%= format_money(budget_category.available_to_spend_money.abs) %></span>
          <% end %>
        </div>
      </div>

    <% else %>
      <%# Uninitialized budget - show simple view %>
      <div class="flex items-center gap-3">
        <%= render DS::LabelDot.new(color: budget_category.category.color) %>

        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-primary truncate"><%= category_display_name %></p>
          <p class="text-sm text-secondary font-medium privacy-sensitive">
            <%= t("budget_categories.budget_category_form.monthly_average", amount: budget_category.median_monthly_expense_money.format(precision: 0)) %>
          </p>
        </div>

        <div class="ml-auto text-right flex-shrink-0">
          <p class="font-mono text-sm tabular-nums text-primary whitespace-nowrap privacy-sensitive"><%= format_money(budget_category.actual_spending_money) %></p>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
