<%# locals: (category:, attention: false) %>
<% category ||= Category.uncategorized %>

<%# Canonical category badge: the label's colour square and its name in a
    hairline box. `attention: true` marks a transaction still waiting for a
    label (amber, as on a statement review). truncate + min-w-0 keep long
    names ellipsizing inside tight columns such as the transaction row. %>
<div class="min-w-0">
  <%= tag.span class: class_names(
        "inline-flex max-w-full min-h-8 items-center gap-2 rounded-sm border px-2 text-sm text-primary",
        attention ? "border-warning bg-warning/10" : "border-divider"
      ),
      title: category.display_name do %>
    <%= render DS::LabelDot.new(color: category.color) %>
    <span class="truncate" data-testid="category-name"><%= category.display_name %></span>
  <% end %>
</div>
